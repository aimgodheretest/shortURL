<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Short URLs</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="brand">URL<span>Shortener</span></div>
      <div>
        <a href="/login">Login</a>
        <a href="/signup">Signup</a>
      </div>
    </nav>

    <div class="page-wrapper">
      <h1>URL Shortener</h1>

      <% if (locals.id) { %>
        <div class="generated-banner">
          URL Generated: http://localhost:4000/<%= id %>
        </div>
      <% } %>

      <div class="card">
        <form class="url-form" action="/url" method="POST">
          <label>Enter Your Original URL Here:</label>
          <input type="text" name="url" placeholder="https://example.com" />
          <button type="submit">Generate</button>
        </form>

        <% if (locals.urls && urls.length > 0) { %>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>S.No</th>
                  <th>ShortID</th>
                  <th>Redirect</th>
                  <th>Clicks</th>
                </tr>
              </thead>
              <tbody>
                <% urls.forEach((url, index) => { %>
                  <tr>
                    <td data-label="S.No"><%= index + 1 %></td>
                    <td data-label="ShortID"><%= url.shortId %></td>
                    <td data-label="Redirect"><%= url.redirectURL %></td>
                    <td data-label="Clicks"><%= url.visitHistory.length %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No short URLs created yet.</div>
        <% } %>
      </div>
    </div>
  </body>
</html>
